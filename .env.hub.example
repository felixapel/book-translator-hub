# Book Translator Hub managed-install input. Copy this file outside the checkout,
# replace every example path/name/origin, then run `./btctl plan --env <file>`.
# It is deliberately a local-provider example: do not put a provider key here.

# btctl hub lifecycle identity. `unraid` requires three different existing,
# private persistent directories. Do not nest one directory below another.
BT_TOPOLOGY=hub
BT_INSTALL_PROFILE=unraid
BT_INSTALL_NAME=book-translator-hub
BT_STATE_DIR=/mnt/user/appdata/book-translator-hub/state
BT_DATA_DIR=/mnt/user/appdata/book-translator-hub/data
BT_BACKUP_DIR=/mnt/user/backups/book-translator-hub

# Each enabled reader keeps its own public origin, stock-container name, existing
# Docker network, internal upstream and published hub proxy port. The upstream
# hostname must exactly equal the reader container name.
BT_ENABLE_CWA=true
BT_CWA_PUBLIC_ORIGIN=https://books.example.test
BT_CWA_READER_CONTAINER=calibre-web
BT_CWA_READER_NETWORK=cwa_default
BT_CWA_READER_UPSTREAM=http://calibre-web:8083
BT_CWA_READER_VERSION=4.0.6
BT_CWA_AUTH_PROFILE=reader-session
BT_CWA_READER_CONNECTOR_ID=01234567-89ab-4cde-8123-0123456789ab
BT_CWA_PUBLISHED_PORT=8385

BT_ENABLE_KAVITA=true
BT_KAVITA_PUBLIC_ORIGIN=https://kavita.example.test
BT_KAVITA_READER_CONTAINER=kavita
BT_KAVITA_READER_NETWORK=kavita_default
BT_KAVITA_READER_UPSTREAM=http://kavita:5000
# The managed default stays on the exact supported 0.9.0.2 contract. Set the
# exact observed version only after confirming its documented contract.
BT_KAVITA_READER_VERSION=0.9.0.2
BT_KAVITA_AUTH_PROFILE=reader-session
BT_KAVITA_READER_CONNECTOR_ID=11234567-89ab-4cde-8123-0123456789ab
BT_KAVITA_PUBLISHED_PORT=8386

# Generate a fresh, different canonical UUID for each connector before install
# (for example: `uuidgen`). Never reuse the example IDs above between installs.

# Local OpenAI-compatible provider example. Replace the hostname and model with
# the operator's local service; keep this endpoint inside the trusted network.
LLM_PROVIDER=local
LLM_MODEL=local-model
LLM_API_KEY=
BT_LOCAL_URL=http://local-llm:8000/v1/chat/completions

# Shared hub budgets; allocations are split between the enabled readers.
BT_MAX_CONCURRENT=2
BT_MAX_UPSTREAM_INFLIGHT=2
BT_BATCH_SIZE=5
BT_BATCH_SOURCE_TOKEN_BUDGET=0
BT_BATCH_MAX_TOKENS=8192
BT_TIMEOUT=90
BT_MAX_BATCH_PARAGRAPHS=50
