# ==============================================================================
# Book Translator Hub — Environment Configuration
# Universal Multi-Reader Setup (Calibre-Web / CWA & Kavita)
# ==============================================================================

# --- Reader Integrations & Upstreams ---
BT_ENABLE_CWA=true
BT_ENABLE_KAVITA=true
BT_ROLE=hub

# --- Hub deployment locations (required by docker-compose.hub.yml) ---
# BT_DATA_DIR must be a private persistent directory (mode 0700 or 2750,
# owned by uid 101 gid 102). BT_*_READER_NETWORK must name the existing
# external Docker networks that reach each reader container.
BT_DATA_DIR=/srv/book-translator-hub/data
BT_CWA_READER_NETWORK=cwa-reader
BT_KAVITA_READER_NETWORK=kavita-reader
# Optional compose overrides:
# BT_IMAGE=local/book-translator-hub:2.4.0
# BT_INSTALL_NAME=book-translator-hub
# BT_HUB_ENV_FILE=.env.hub

# --- Browser-facing origins (one exact https origin per enabled reader) ---
BT_CWA_PUBLIC_ORIGIN=https://books.example.test
BT_KAVITA_PUBLIC_ORIGIN=https://kavita.example.test

# --- Reader upstreams (exact http URLs of your reader instances) ---
# CWA_URL/KAVITA_URL below are accepted as aliases; the explicit
# BT_*_READER_UPSTREAM values win when both are set.
BT_CWA_READER_UPSTREAM=http://calibre-web:8083
BT_KAVITA_READER_UPSTREAM=http://kavita:5000

# --- Certified reader versions ---
BT_CWA_READER_VERSION=4.0.6
BT_KAVITA_READER_VERSION=0.9.0.2

# --- Reader auth profiles (hub supports reader-session) ---
BT_CWA_AUTH_PROFILE=reader-session
BT_KAVITA_AUTH_PROFILE=reader-session

# --- Per-reader connector IDs (canonical UUIDs; generate fresh ones) ---
BT_CWA_READER_CONNECTOR_ID=01234567-89ab-4cde-8123-0123456789ab
BT_KAVITA_READER_CONNECTOR_ID=11234567-89ab-4cde-8123-0123456789ab

# --- Published ports (must be distinct per enabled reader) ---
BT_CWA_PUBLISHED_PORT=8385
BT_KAVITA_PUBLISHED_PORT=8386

# Reader URLs / IPs (Configure the direct HTTP URLs of your reader instances)
# Standard Calibre-Web port is 8083 (or 8383 on Unraid/Docker)
CWA_URL=http://192.168.0.122:8383
# Standard Kavita port is 5000 (or 5547 on Unraid/Docker)
KAVITA_URL=http://192.168.0.122:5547

# Production auth: token mode with an explicit secret. For local development
# only you may use BT_AUTH_MODE=disabled with BT_ALLOW_INSECURE_AUTH=true;
# never expose a disabled-auth hub beyond localhost.
BT_AUTH_MODE=token
BT_API_TOKEN=change-me-to-a-long-random-secret

# --- Port Configuration ---
# API_PORT (or PORT): Direct translation API port (REST + SSE streaming)
PORT=8390
API_PORT=8390

# PROXY_PORT (or BT_PROXY_PORT): Reader reverse proxy injection port
BT_PROXY_PORT=8080
PROXY_PORT=8080

# --- LLM Provider & Routing ---
# Recommended Providers: local (vLLM / Ollama / Bifrost), groq, gemini, deepseek, openai
LLM_PROVIDER=local
BT_LOCAL_URL=http://192.168.0.122:2819/v1/chat/completions
LLM_MODEL=gemma4-12b
LLM_API_KEY=

# --- Allowed Origins for CORS ---
BT_ALLOWED_ORIGINS=http://localhost:8083,http://localhost:8383

# --- High-Throughput Batching Economics ---
BT_BATCH_SIZE=5
BT_BATCH_SOURCE_TOKEN_BUDGET=1400
BT_BATCH_MAX_TOKENS=3500
BT_TIMEOUT=90
BT_MAX_CONCURRENT=4
BT_MAX_UPSTREAM_INFLIGHT=4
BT_CLIENT_PREFETCH_GAP_MS=500
BT_MAX_BATCH_PARAGRAPHS=50
