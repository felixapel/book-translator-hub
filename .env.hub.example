# ==============================================================================
# Book Translator Hub — Environment Configuration
# Universal Multi-Reader Setup (Calibre-Web / CWA & Kavita)
# ==============================================================================

# --- Reader Integrations & Upstreams ---
BT_ENABLE_CWA=true
BT_ENABLE_KAVITA=true
BT_ROLE=api

# Reader URLs / IPs (Configure the direct HTTP URLs of your reader instances)
# Standard Calibre-Web port is 8083 (or 8383 on Unraid/Docker)
CWA_URL=http://192.168.0.122:8383
# Standard Kavita port is 5000 (or 5547 on Unraid/Docker)
KAVITA_URL=http://192.168.0.122:5547

# Production auth: token mode with an explicit secret. For local development
# only you may use BT_AUTH_MODE=disabled with BT_ALLOW_INSECURE_AUTH=true;
# never expose a disabled-auth hub beyond localhost.
BT_AUTH_MODE=token
BT_API_TOKEN=change-me-to-a-long-random-secret

# --- Port Configuration ---
# API_PORT (or PORT): Direct translation API port (REST + SSE streaming)
PORT=8390
API_PORT=8390

# PROXY_PORT (or BT_PROXY_PORT): Reader reverse proxy injection port
BT_PROXY_PORT=8080
PROXY_PORT=8080

# --- LLM Provider & Routing ---
# Recommended Providers: local (vLLM / Ollama / Bifrost), groq, gemini, deepseek, openai
LLM_PROVIDER=local
BT_LOCAL_URL=http://192.168.0.122:2819/v1/chat/completions
LLM_MODEL=gemma4-12b
LLM_API_KEY=

# --- Allowed Origins for CORS ---
BT_ALLOWED_ORIGINS=http://localhost:8083,http://localhost:8383

# --- High-Throughput Batching Economics ---
BT_BATCH_SIZE=5
BT_BATCH_SOURCE_TOKEN_BUDGET=1400
BT_BATCH_MAX_TOKENS=3500
BT_TIMEOUT=90
BT_MAX_CONCURRENT=4
BT_MAX_UPSTREAM_INFLIGHT=4
BT_CLIENT_PREFETCH_GAP_MS=500
BT_MAX_BATCH_PARAGRAPHS=50
